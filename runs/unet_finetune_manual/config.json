{
  "data": {
    "manifest": "data/manifest_finetune_manual.csv",
    "splits": "data/splits_finetune_manual.csv",
    "image_column": "image_path",
    "mask_column": "mask_path",
    "cache_images": true
  },
  "split": {
    "val_fraction": 0.15,
    "test_fraction": 0.15,
    "seed": 42
  },
  "patches": {
    "patch_size": 512,
    "patches_per_image": 48,
    "positive_patch_fraction": 0.75
  },
  "augmentation": {
    "enable": true,
    "flip": true,
    "rotate90": true,
    "intensity_jitter": 0.1
  },
  "model": {
    "in_channels": 1,
    "out_channels": 1,
    "base_channels": 32,
    "depth": 4,
    "dropout": 0.05
  },
  "checkpoint": {
    "init": "runs/unet_baseline/best.pt"
  },
  "training": {
    "epochs": 40,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 1e-05,
    "num_workers": 2,
    "device": "auto",
    "amp": true,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "cudnn_benchmark": true,
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "threshold": 0.5
  },
  "output": {
    "run_dir": "runs/unet_finetune_manual",
    "save_every_epochs": 5
  }
}